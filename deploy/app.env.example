# Copy to deploy/app.env and fill in. NEVER commit the real app.env.
# docker-compose builds DATABASE_URL/DIRECT_DATABASE_URL from POSTGRES_* below.

# --- Postgres (internal only) ---
POSTGRES_USER=examsexpress
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=examsexpress

# --- Auth / sessions ---
SESSION_SECRET=change-me-32+chars-random
SESSION_COOKIE_NAME=ee_session
SESSION_IDLE_TIMEOUT_MINUTES=20

# --- Google OAuth (add examsexpress.in/api/auth/google/callback in Google Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OTP / SMS: switch to MSG91 for India (see the OTP fix) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# (Twilio vars only if you stay on Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Payments (Razorpay LIVE keys once KYC is done) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI (question generation / translate) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- GST/billing: leave UNSET to keep tax OFF until CA sign-off ---
# GST_RATE_BPS=1800
# GST_SAC_CODE=999293
# PLATFORM_GSTIN=
